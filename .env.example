# Desenvolvimento local
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/genect_dev?schema=public"
POSTGRES_USER="USER"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_DB="genect_dev"

# Homologacao/Vercel
# Configure DATABASE_URL no painel do Vercel e no provedor PostgreSQL remoto.
# Em runtime serverless, preferir a URL com pool de conexoes quando o provedor oferecer.
# Para aplicar migrations em homologacao, use somente `npm run db:deploy` contra o banco remoto.
# Nao use `prisma migrate dev`, `prisma db push` ou `prisma migrate reset` em homologacao.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
