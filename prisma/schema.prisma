generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                 String                 @id @default(cuid())
  name               String
  tradeName          String?
  document           String?
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  productionOrders   ProductionOrder[]
  settlements        ContractorSettlement[]
  accountsPayable    AccountPayable[]
  billings           Billing[]
  accountsReceivable AccountReceivable[]
}

model Customer {
  id                 String              @id @default(cuid())
  name               String
  document           String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productionOrders   ProductionOrder[]
  accountsReceivable AccountReceivable[]
}

model Product {
  id               String            @id @default(cuid())
  name             String
  reference        String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productionOrders ProductionOrder[]
}

model ProductionOrder {
  id                 String              @id @default(cuid())
  number             String
  entryDate          DateTime            @db.Date
  companyId          String
  customerId         String
  productId          String
  quantity           Int
  unitPrice          Decimal             @db.Decimal(14, 4)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  outsourcedServices OutsourcedService[]
  billing            Billing?

  @@unique([companyId, number])
  @@index([number])
  @@index([customerId])
  @@index([productId])
  @@index([entryDate])
}

model Billing {
  id                String             @id @default(cuid())
  productionOrderId String             @unique
  companyId         String
  invoiceNumber     String
  issueDate         DateTime           @db.Date
  amount            Decimal            @db.Decimal(14, 4)
  competenceDate    DateTime           @db.Date
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  accountReceivable AccountReceivable?

  @@unique([companyId, invoiceNumber])
  @@index([issueDate])
  @@index([competenceDate])
}

model AccountReceivable {
  id             String   @id @default(cuid())
  companyId      String
  customerId     String
  billingId      String   @unique
  description    String
  competenceDate DateTime @db.Date
  dueDate        DateTime @db.Date
  originalAmount Decimal  @db.Decimal(14, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billing        Billing  @relation(fields: [billingId], references: [id], onDelete: Restrict)

  @@index([companyId, dueDate])
  @@index([customerId, dueDate])
  @@index([competenceDate])
  @@index([dueDate])
}

model Contractor {
  id                 String                 @id @default(cuid())
  name               String
  document           String?
  phone              String?
  address            String?
  notes              String?
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  outsourcedServices OutsourcedService[]
  deliveryNotes      DeliveryNote[]
  settlements        ContractorSettlement[]
}

model Service {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  prices             ServicePrice[]
  outsourcedServices OutsourcedService[]
}

model ServicePrice {
  id         String    @id @default(cuid())
  serviceId  String
  unitPrice  Decimal   @db.Decimal(14, 4)
  validFrom  DateTime  @db.Date
  validUntil DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, validFrom])
}

model OutsourcedService {
  id                String                     @id @default(cuid())
  productionOrderId String
  serviceId         String
  contractorId      String
  plannedQuantity   Int?
  approvedQuantity  Int                        @default(0)
  appliedUnitPrice  Decimal                    @db.Decimal(14, 4)
  notes             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  productionOrder   ProductionOrder            @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  service           Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  contractor        Contractor                 @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  deliveryNoteItems DeliveryNoteItem[]
  returns           OutsourcingReturn[]
  settlementItems   ContractorSettlementItem[]

  @@index([productionOrderId])
  @@index([serviceId])
  @@index([contractorId])
}

enum ContractorSettlementStatus {
  DRAFT
  APPROVED
}

model ContractorSettlement {
  id             String                     @id @default(cuid())
  contractorId   String
  companyId      String
  periodYear     Int
  periodMonth    Int
  status         ContractorSettlementStatus @default(DRAFT)
  notes          String?
  approvedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  contractor     Contractor                 @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items          ContractorSettlementItem[]
  accountPayable AccountPayable?

  @@index([companyId, periodYear, periodMonth])
  @@index([contractorId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
}

model AccountPayable {
  id                     String               @id @default(cuid())
  companyId              String
  contractorSettlementId String               @unique
  description            String
  competenceDate         DateTime             @db.Date
  dueDate                DateTime             @db.Date
  originalAmount         Decimal              @db.Decimal(14, 4)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contractorSettlement   ContractorSettlement @relation(fields: [contractorSettlementId], references: [id], onDelete: Restrict)
  payments               Payment[]

  @@index([companyId, dueDate])
  @@index([dueDate])
  @@index([competenceDate])
}

model Payment {
  id               String         @id @default(cuid())
  accountPayableId String
  paymentDate      DateTime       @db.Date
  amount           Decimal        @db.Decimal(14, 4)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  accountPayable   AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Restrict)

  @@index([accountPayableId, paymentDate])
  @@index([paymentDate])
}

model ContractorSettlementItem {
  id                       String               @id @default(cuid())
  settlementId             String
  outsourcedServiceId      String
  approvedQuantityIncluded Int
  appliedUnitPriceSnapshot Decimal              @db.Decimal(14, 4)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  settlement               ContractorSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  outsourcedService        OutsourcedService    @relation(fields: [outsourcedServiceId], references: [id], onDelete: Restrict)

  @@unique([settlementId, outsourcedServiceId])
  @@index([outsourcedServiceId])
}

model DeliveryNote {
  id              String             @id @default(cuid())
  number          String             @unique
  contractorId    String
  departureDate   DateTime           @db.Date
  responsibleName String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  contractor      Contractor         @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  items           DeliveryNoteItem[]

  @@index([contractorId])
  @@index([departureDate])
}

model DeliveryNoteItem {
  id                  String            @id @default(cuid())
  deliveryNoteId      String
  outsourcedServiceId String
  quantity            Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveryNote        DeliveryNote      @relation(fields: [deliveryNoteId], references: [id], onDelete: Restrict)
  outsourcedService   OutsourcedService @relation(fields: [outsourcedServiceId], references: [id], onDelete: Restrict)

  @@index([deliveryNoteId])
  @@index([outsourcedServiceId])
}

model OutsourcingReturn {
  id                  String            @id @default(cuid())
  outsourcedServiceId String
  returnDate          DateTime          @db.Date
  quantity            Int
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  outsourcedService   OutsourcedService @relation(fields: [outsourcedServiceId], references: [id], onDelete: Restrict)

  @@index([outsourcedServiceId, returnDate])
}
