generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                 String                 @id @default(cuid())
  name               String
  tradeName          String?
  document           String?
  stateRegistration  String?
  phone              String?
  whatsapp           String?
  email              String?
  postalCode         String?
  address            String?
  addressNumber      String?
  addressComplement  String?
  neighborhood       String?
  city               String?
  state              String?
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  productionOrders   ProductionOrder[]
  settlements        ContractorSettlement[]
  accountsPayable    AccountPayable[]
  billings           Billing[]
  accountsReceivable AccountReceivable[]
  receipts           Receipt[]
  budgets            Budget[]
}

enum CustomerType {
  PF
  PJ
}

enum UserRole {
  ADMIN
  FINANCE
  OPERATIONS
  VIEWER
  CONTRACTOR
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  passwordHash     String
  role             UserRole
  contractorId     String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sessions         Session[]
  approvedBudgets  Budget[]           @relation("BudgetApprovedBy")
  closedBudgets    Budget[]           @relation("BudgetClosedBy")
  payments         Payment[]
  receipts         Receipt[]
  manualPayables   AccountPayable[]
  paymentReversals PaymentReversal[]
  receiptReversals ReceiptReversal[]
  contractor       Contractor?        @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  createdIssues    OperationalIssue[] @relation("OperationalIssueCreatedBy")
  resolvedIssues   OperationalIssue[] @relation("OperationalIssueResolvedBy")
  createdProductionOrders ProductionOrder[] @relation("ProductionOrderCreatedBy")
  completedProductionOrders ProductionOrder[] @relation("ProductionOrderCompletedBy")
  createdOutsourcedServices OutsourcedService[] @relation("OutsourcedServiceCreatedBy")
  createdInternalServices   InternalProductionService[] @relation("InternalProductionServiceCreatedBy")
  completedInternalServices InternalProductionService[] @relation("InternalProductionServiceCompletedBy")

  @@index([active, role])
  @@index([contractorId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum DreGroup {
  VARIABLE_COST_EXPENSE
  FIXED_COST_EXPENSE
  FINANCIAL_REVENUE
  FINANCIAL_EXPENSE
  INCOME_TAX_EXPENSE
}

enum FinancialNature {
  OPERATING_EXPENSE
  DRE_POST_OPERATING
  NON_DRE
}

enum AccountPayableSource {
  CONTRACTOR_SETTLEMENT
  MANUAL
}

enum BudgetEntryType {
  GROSS_REVENUE
  FINANCIAL_CLASSIFICATION
}

enum BudgetStatus {
  DRAFT
  APPROVED
  CLOSED
}

model FinancialClassification {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  financialNature FinancialNature
  dreGroup        DreGroup?
  active          Boolean          @default(true)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accountsPayable AccountPayable[]
  budgetEntries   BudgetEntry[]

  @@index([financialNature, dreGroup, active])
  @@index([name])
}

model Budget {
  id               String        @id @default(cuid())
  companyId        String
  competenceDate   DateTime      @db.Date
  notes            String?
  status           BudgetStatus  @default(DRAFT)
  approvedAt       DateTime?
  closedAt         DateTime?
  approvedByUserId String?
  closedByUserId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries          BudgetEntry[]
  approvedBy       User?         @relation("BudgetApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  closedBy         User?         @relation("BudgetClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, competenceDate])
  @@index([competenceDate])
  @@index([status])
}

model BudgetEntry {
  id                         String                   @id @default(cuid())
  budgetId                   String
  entryType                  BudgetEntryType
  classificationId           String?
  classificationCodeSnapshot String?
  classificationNameSnapshot String?
  financialNatureSnapshot    FinancialNature?
  dreGroupSnapshot           DreGroup?
  amount                     Decimal                  @db.Decimal(14, 4)
  notes                      String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  budget                     Budget                   @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  classification             FinancialClassification? @relation(fields: [classificationId], references: [id], onDelete: Restrict)

  @@unique([budgetId, classificationId])
  @@index([budgetId, entryType])
  @@index([classificationId])
}

model Customer {
  id                 String              @id @default(cuid())
  name               String
  personType         CustomerType?
  tradeName          String?
  document           String?
  stateRegistration  String?
  phone              String?
  whatsapp           String?
  email              String?
  postalCode         String?
  address            String?
  addressNumber      String?
  addressComplement  String?
  neighborhood       String?
  city               String?
  state              String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productionOrders   ProductionOrder[]
  accountsReceivable AccountReceivable[]
  receipts           Receipt[]
  products           Product[]
}

model Product {
  id               String            @id @default(cuid())
  name             String
  reference        String?
  customerId       String?
  color            String?
  currentUnitPrice Decimal?          @db.Decimal(14, 4)
  imageUrl         String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productionOrders ProductionOrder[]
  supplies         ProductSupply[]

  @@index([customerId])
  @@index([reference])
}

model ProductionOrder {
  id                     String              @id @default(cuid())
  number                 String
  entryDate              DateTime            @db.Date
  companyId              String
  customerId             String
  productId              String
  quantity               Int
  unitPrice              Decimal             @db.Decimal(14, 4)
  isUrgent               Boolean             @default(false)
  expectedCompletionDate DateTime?           @db.Date
  completedAt            DateTime?
  createdByUserId        String?
  completedByUserId      String?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer               Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product                Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  outsourcedServices     OutsourcedService[]
  billing                Billing?
  operationalIssues      OperationalIssue[]
  supplies               ProductionOrderSupply[]
  internalServices       InternalProductionService[]
  createdBy              User?                 @relation("ProductionOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy            User?                 @relation("ProductionOrderCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([number])
  @@index([customerId])
  @@index([productId])
  @@index([entryDate])
  @@index([createdByUserId])
  @@index([completedByUserId])
}

model Billing {
  id                String             @id @default(cuid())
  productionOrderId String             @unique
  companyId         String
  invoiceNumber     String
  issueDate         DateTime           @db.Date
  amount            Decimal            @db.Decimal(14, 4)
  competenceDate    DateTime           @db.Date
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  accountReceivable AccountReceivable?

  @@unique([companyId, invoiceNumber])
  @@index([issueDate])
  @@index([competenceDate])
}

model AccountReceivable {
  id             String              @id @default(cuid())
  companyId      String
  customerId     String
  billingId      String              @unique
  description    String
  competenceDate DateTime            @db.Date
  dueDate        DateTime            @db.Date
  originalAmount Decimal             @db.Decimal(14, 4)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billing        Billing             @relation(fields: [billingId], references: [id], onDelete: Restrict)
  allocations    ReceiptAllocation[]

  @@index([companyId, dueDate])
  @@index([customerId, dueDate])
  @@index([competenceDate])
  @@index([dueDate])
}

model Receipt {
  id              String              @id @default(cuid())
  companyId       String
  customerId      String
  receiptDate     DateTime            @db.Date
  amount          Decimal             @db.Decimal(14, 4)
  notes           String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocations     ReceiptAllocation[]
  reversal        ReceiptReversal?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, receiptDate])
  @@index([customerId, receiptDate])
  @@index([receiptDate])
}

model ReceiptReversal {
  id              String   @id @default(cuid())
  receiptId       String   @unique
  reversalDate    DateTime @db.Date
  reason          String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  receipt         Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([reversalDate])
}

model ReceiptAllocation {
  id                  String            @id @default(cuid())
  receiptId           String
  accountReceivableId String
  amount              Decimal           @db.Decimal(14, 4)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  receipt             Receipt           @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  accountReceivable   AccountReceivable @relation(fields: [accountReceivableId], references: [id], onDelete: Restrict)

  @@unique([receiptId, accountReceivableId])
  @@index([accountReceivableId])
}

model Contractor {
  id                  String                 @id @default(cuid())
  name                String
  document            String?
  phone               String?
  whatsapp            String?
  email               String?
  postalCode          String?
  address             String?
  addressNumber       String?
  addressComplement   String?
  neighborhood        String?
  city                String?
  state               String?
  pixKey              String?
  notes               String?
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  outsourcedServices  OutsourcedService[]
  deliveryNotes       DeliveryNote[]
  settlements         ContractorSettlement[]
  serviceCapabilities ServiceContractor[]
  users               User[]
  operationalIssues   OperationalIssue[]
}

model Service {
  id                         String                  @id @default(cuid())
  name                       String
  description                String?
  active                     Boolean                 @default(true)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  outsourcedServices         OutsourcedService[]
  internalSectorCapabilities ServiceInternalSector[]
  contractorCapabilities     ServiceContractor[]
  internalProductionServices InternalProductionService[]
}

model InternalSector {
  id                  String                  @id @default(cuid())
  name                String                  @unique
  active              Boolean                 @default(true)
  displayOrder        Int                     @default(0)
  notes               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  serviceCapabilities ServiceInternalSector[]
  productionServices  InternalProductionService[]

  @@index([active, displayOrder])
}

model ServiceInternalSector {
  serviceId        String
  internalSectorId String
  createdAt        DateTime       @default(now())
  service          Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  internalSector   InternalSector @relation(fields: [internalSectorId], references: [id], onDelete: Restrict)

  @@id([serviceId, internalSectorId])
  @@index([internalSectorId])
}

model ServiceContractor {
  serviceId    String
  contractorId String
  unitPrice    Decimal?   @db.Decimal(14, 4)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  @@id([serviceId, contractorId])
  @@index([contractorId])
}

model Supply {
  id        String          @id @default(cuid())
  name      String          @unique
  unit      String
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  products  ProductSupply[]
  productionOrders ProductionOrderSupply[]

  @@index([active, name])
}

model ProductSupply {
  productId       String
  supplyId        String
  quantityPerBase Decimal? @db.Decimal(14, 4)
  baseQuantity    Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  supply          Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@id([productId, supplyId])
  @@index([supplyId])
}

model ProductionOrderSupply {
  id                      String          @id @default(cuid())
  productionOrderId       String
  supplyId                String
  supplyNameSnapshot      String
  unitSnapshot            String
  quantityPerBaseSnapshot Decimal?        @db.Decimal(14, 4)
  baseQuantitySnapshot    Int?
  plannedQuantity         Decimal?        @db.Decimal(14, 4)
  notes                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  productionOrder         ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  supply                  Supply          @relation(fields: [supplyId], references: [id], onDelete: Restrict)

  @@unique([productionOrderId, supplyId])
  @@index([supplyId])
}

model InternalProductionService {
  id                 String          @id @default(cuid())
  productionOrderId  String
  serviceId          String
  internalSectorId   String
  plannedQuantity    Int?
  notes              String?
  createdByUserId    String?
  completedAt        DateTime?
  completedByUserId  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  productionOrder    ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  service            Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  internalSector     InternalSector  @relation(fields: [internalSectorId], references: [id], onDelete: Restrict)
  createdBy          User?           @relation("InternalProductionServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy        User?           @relation("InternalProductionServiceCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
  @@index([serviceId])
  @@index([internalSectorId])
  @@index([createdByUserId])
  @@index([completedByUserId])
}

model OutsourcedService {
  id                String                     @id @default(cuid())
  productionOrderId String
  serviceId         String
  contractorId      String
  plannedQuantity   Int?
  approvedQuantity  Int                        @default(0)
  appliedUnitPrice  Decimal                    @db.Decimal(14, 4)
  notes             String?
  expectedReturnDate DateTime?                  @db.Date
  createdByUserId   String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  productionOrder   ProductionOrder            @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  service           Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  contractor        Contractor                 @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  deliveryNoteItems DeliveryNoteItem[]
  returns           OutsourcingReturn[]
  settlementItems   ContractorSettlementItem[]
  operationalIssues OperationalIssue[]
  createdBy         User?                      @relation("OutsourcedServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
  @@index([serviceId])
  @@index([contractorId])
  @@index([expectedReturnDate])
  @@index([createdByUserId])
}

enum OperationalIssueType {
  MISSING_THREAD
  MISSING_TRIM
  MISSING_COMPONENT
  QUANTITY_ISSUE
  EXECUTION_QUESTION
  OTHER
}

enum OperationalIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model OperationalIssue {
  id                  String                 @id @default(cuid())
  productionOrderId   String
  outsourcedServiceId String?
  contractorId        String
  createdByUserId     String
  type                OperationalIssueType
  description         String
  status              OperationalIssueStatus @default(OPEN)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  resolvedAt          DateTime?
  resolvedByUserId    String?
  productionOrder     ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  outsourcedService   OutsourcedService?     @relation(fields: [outsourcedServiceId], references: [id], onDelete: Restrict)
  contractor          Contractor             @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  createdBy           User                   @relation("OperationalIssueCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  resolvedBy          User?                  @relation("OperationalIssueResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([productionOrderId, status])
  @@index([outsourcedServiceId])
  @@index([contractorId, status])
  @@index([createdByUserId])
  @@index([resolvedByUserId])
}

enum ContractorSettlementStatus {
  DRAFT
  APPROVED
}

model ContractorSettlement {
  id             String                     @id @default(cuid())
  contractorId   String
  companyId      String
  periodYear     Int
  periodMonth    Int
  status         ContractorSettlementStatus @default(DRAFT)
  notes          String?
  approvedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  contractor     Contractor                 @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  items          ContractorSettlementItem[]
  accountPayable AccountPayable?

  @@index([companyId, periodYear, periodMonth])
  @@index([contractorId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
}

model AccountPayable {
  id                         String                  @id @default(cuid())
  companyId                  String
  contractorSettlementId     String?                 @unique
  source                     AccountPayableSource
  classificationId           String
  classificationCodeSnapshot String
  classificationNameSnapshot String
  financialNatureSnapshot    FinancialNature
  dreGroupSnapshot           DreGroup?
  payeeName                  String
  description                String
  competenceDate             DateTime                @db.Date
  dueDate                    DateTime                @db.Date
  originalAmount             Decimal                 @db.Decimal(14, 4)
  createdByUserId            String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  company                    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contractorSettlement       ContractorSettlement?   @relation(fields: [contractorSettlementId], references: [id], onDelete: Restrict)
  classification             FinancialClassification @relation(fields: [classificationId], references: [id], onDelete: Restrict)
  payments                   Payment[]
  createdBy                  User?                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, dueDate])
  @@index([companyId, competenceDate, financialNatureSnapshot, dreGroupSnapshot])
  @@index([classificationId])
  @@index([source])
  @@index([dueDate])
  @@index([competenceDate])
}

model Payment {
  id               String           @id @default(cuid())
  accountPayableId String
  paymentDate      DateTime         @db.Date
  amount           Decimal          @db.Decimal(14, 4)
  notes            String?
  createdByUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accountPayable   AccountPayable   @relation(fields: [accountPayableId], references: [id], onDelete: Restrict)
  reversal         PaymentReversal?
  createdBy        User?            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([accountPayableId, paymentDate])
  @@index([paymentDate])
}

model PaymentReversal {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  reversalDate    DateTime @db.Date
  reason          String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([reversalDate])
}

model ContractorSettlementItem {
  id                       String               @id @default(cuid())
  settlementId             String
  outsourcedServiceId      String
  approvedQuantityIncluded Int
  appliedUnitPriceSnapshot Decimal              @db.Decimal(14, 4)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  settlement               ContractorSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  outsourcedService        OutsourcedService    @relation(fields: [outsourcedServiceId], references: [id], onDelete: Restrict)

  @@unique([settlementId, outsourcedServiceId])
  @@index([outsourcedServiceId])
}

model DeliveryNote {
  id              String             @id @default(cuid())
  number          String             @unique
  contractorId    String
  departureDate   DateTime           @db.Date
  responsibleName String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  contractor      Contractor         @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  items           DeliveryNoteItem[]

  @@index([contractorId])
  @@index([departureDate])
}

model DeliveryNoteItem {
  id                  String            @id @default(cuid())
  deliveryNoteId      String
  outsourcedServiceId String
  quantity            Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveryNote        DeliveryNote      @relation(fields: [deliveryNoteId], references: [id], onDelete: Restrict)
  outsourcedService   OutsourcedService @relation(fields: [outsourcedServiceId], references: [id], onDelete: Restrict)

  @@index([deliveryNoteId])
  @@index([outsourcedServiceId])
}

model OutsourcingReturn {
  id                  String            @id @default(cuid())
  outsourcedServiceId String
  returnDate          DateTime          @db.Date
  quantity            Int
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  outsourcedService   OutsourcedService @relation(fields: [outsourcedServiceId], references: [id], onDelete: Restrict)

  @@index([outsourcedServiceId, returnDate])
}
